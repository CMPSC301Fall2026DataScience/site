{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "CMPSC 301 JupyterLite",
    "appVersion": "0.1.0",
    "appUrl": "./lab",
    "collaborative": false,
    "disabledExtensions": [],
    "enableMemoryStorage": true,
    "settingsStorageDrivers": ["localStorage"]
  },
  "litePluginSettings": {
    "@jupyterlite/pyodide-kernel-extension:kernel": {
      "pyodideUrl": "https://cdn.jsdelivr.net/pyodide/v0.26.2/full/",
      "pipliteWheelUrl": "https://cdn.jsdelivr.net/pyodide/v0.26.2/full/",
      "pipliteUrls": [
        "https://cdn.jsdelivr.net/pyodide/v0.26.2/full/",
        "https://pypi.org/pypi/{package_name}/json"
      ],
      "disablePyPIFallback": false
    }
  }
}